#!/usr/bin/env python3

description = '''
'''

import socket 
import os
import sys
import numpy as np
import meshio
from scipy.integrate import solve_bvp

import matplotlib.pyplot as plt
from datetime import datetime
import warnings
import yaml

# ---------------------------------------------------------------
# Les parametres physiques ne sont pas definis ici :
# - A (Ae) et Ku (K) sont lus dans le fichier settings.yml,
# - le rayon R du cylindre est deduit du maillage.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Variables adimensionnelles et domaine d'integration
# ---------------------------------------------------------------
epsilon = 1e-6    # Limite inferieure du domaine : rayon de coeur r0 = epsilon*R, tres petit devant R
N = 600           # Nombre de points de discretisation

warnings.simplefilter("always")
warnings.formatwarning = lambda message, category, filename, lineno, line=None: f"{message}\n"

DEBUG = False

# ---------------------------------------------------------------
# Equation d'Euler-Lagrange adimensionnee
# ---------------------------------------------------------------
def make_ode(kappa):
    """ return the right hand side of the Euler-Lagrange equation, kappa = (Ku*R^2)/(2*A) """
    def ode(rho, y):
        omega, domega_drho = y

        # omega'' = -omega'/rho + [1/(2*rho^2) + (Ku*R^2)/(2*A)] * sin(2*omega)
        d2omega_drho2 = -domega_drho / rho + (1.0 / (2 * rho**2) + kappa) * np.sin(2 * omega)

        return np.vstack([domega_drho, d2omega_drho2])
    return ode

# Conditions aux limites : omega(epsilon) = 0 et omega'(1) = 0
def bc(ya, yb):
    return np.array([ya[0] - 0.0,      # omega(epsilon) = 0
                     yb[1] - 0.0])     # omega_rho(1) = 0

def get_region_elements(mesh):
    """
    Return a dictionary mapping region name -> list of element descriptions.
    Only includes volume elements (tetrahedra).
    """
    if not hasattr(mesh, "cells"):
        raise ValueError("mesh has no attribute 'cells'")

    # 1) build mapping physical_id -> (region_name, dimension)
    id_to_name = {}
    for name, arr in mesh.field_data.items():
        try:
            arr_flat = np.asarray(arr).flatten()
            phys_id = int(arr_flat[0])
            dimension = int(arr_flat[1]) if len(arr_flat) > 1 else None
            # Only keep 3D regions (volume)
            if dimension == 3:
                id_to_name[phys_id] = name
                if DEBUG:
                    print(f"  Volume region: {name} (ID={phys_id}, dim={dimension})")
        except Exception:
            continue
    
    if not id_to_name:
        raise ValueError("No volume regions (dimension=3) found in mesh")
    
    if DEBUG:
        print("Volume regions only:", id_to_name)
    
    # 2) find physical tags key
    phys_key = None
    if hasattr(mesh, "cell_data") and mesh.cell_data:
        for k in mesh.cell_data.keys():
            if k == "gmsh:physical":
                phys_key = k
                break
        if phys_key is None:
            for k in mesh.cell_data.keys():
                if "physical" in k.lower():
                    phys_key = k
                    break

    if phys_key is None:
        raise ValueError("No physical tags found in mesh.cell_data.")

    # 3) iterate cell blocks - only process volume elements
    regions = {}
    global_idx = 0
    phys_tags_list = mesh.cell_data[phys_key]
    
    if len(phys_tags_list) != len(mesh.cells):
        raise ValueError(f"Mismatch between cell blocks and cell_data for key '{phys_key}'")

    for block_index, (cell_block, phys_tags) in enumerate(zip(mesh.cells, phys_tags_list)):
        cell_type = cell_block.type
        connectivity = np.asarray(cell_block.data, dtype=int)
        phys_tags = np.asarray(phys_tags, dtype=int).flatten()

        if connectivity.shape[0] != phys_tags.shape[0]:
            raise ValueError(f"Element count mismatch in block {block_index}")

        for local_idx in range(connectivity.shape[0]):
            phys_id = int(phys_tags[local_idx])
            # Only process if this physical ID is in our volume regions
            if phys_id not in id_to_name:
                continue
                
            region_name = id_to_name[phys_id]
            elem = {
                "cell_type": cell_type,
                "block_index": block_index,
                "local_element_index": local_idx,
                "global_element_index": global_idx,
                "nodes": connectivity[local_idx].tolist()
            }
            regions.setdefault(region_name, []).append(elem)
            global_idx += 1

    return regions


def load_mesh(filename):
    """Load mesh and return points, triangles, tetrahedrons, regions."""
    if not os.path.isfile(filename):
        raise FileNotFoundError(f"File '{filename}' does not exist.")

    try:
        mesh = meshio.read(filename)
        if DEBUG:
            print(mesh)
        
        # Display regions info
        for cell_block, cell_data in zip(mesh.cells, mesh.cell_data["gmsh:physical"]):
            cell_type = cell_block.type
            if DEBUG:
                print(f"\nCell type: {cell_type}")
            for region_name, (region_id, dim) in mesh.field_data.items():
                element_indices = np.where(cell_data == region_id)[0]
                if DEBUG and len(element_indices) > 0:
                    print(f"  Region '{region_name}' (ID={region_id}, dim={dim}): "
                            + "{len(element_indices)} elements")

        regions = get_region_elements(mesh)
        points = mesh.points[:, :3]
        
        if DEBUG: # assumption DEBUG set to 1
        # Display all element node indices for each region
            print('DEBUG')
            for region_name, elems in regions.items():
                print(f"\nRegion '{region_name}' — {len(elems)} elements:")
                for elem in elems:
                    print(f"  Element {elem['global_element_index']:4d} ({elem['cell_type']}): "
                            + "nodes {elem['nodes']}")
            print('Number of nodes : ', len(points))

        return points, regions

    except Exception as e:
        raise RuntimeError(f"Error loading mesh '{filename}': {e}")


def apply_region_functions(points, regions, region_functions):
    """Apply region defined functions."""
    m = np.full((len(points), 3), np.nan, dtype=np.float64)
    
    for region_name, elems in regions.items():
        if region_name not in region_functions:
            warnings.warn(f"⚠️ No function defined for region '{region_name}'. Region ignored.")
            continue

        func = region_functions[region_name]
        # Nodes shared by several elements are evaluated only once
        # Meshio uses zero-based indexing
        nodes = np.unique(np.concatenate([elem['nodes'] for elem in elems]))
        n = len(nodes)
        step = max(1, n // 100)  # refresh display every 1 %
        for i, idx in enumerate(nodes):
            xyz = points[idx, :]
            m[idx] = np.array(func(*xyz))
            if i % step == 0 or i == n - 1:
                sys.stdout.write(f"\r   Region '{region_name}': {100 * (i + 1) / n:5.1f} % ({i + 1}/{n} nodes)")
                sys.stdout.flush()
        print()

    norms = np.linalg.norm(m, axis=1)
    nonzero = norms > 0    
    m[nonzero] /= norms[nonzero][:, np.newaxis]
    
    if (np.linalg.norm(m, axis=1) == 0).any():
         warnings.warn(f"⚠️  m contains zero-norm vectors")

    if np.isnan(m).any():
        warnings.warn("m contains non-initialized values")
        sys.exit("❌ abort")

    return m


def write_solution_file(m, filename="config.sol"):
    """Write field m and metadata to config.sol file."""
    now = datetime.now().isoformat()
    hostname = socket.gethostname()
    
    header_lines = [
        "## generator: fg-gensol-curling",
        f"## hostname: {hostname}",
        f"## real-world time: {now}",
        "## time: 0",
        "## columns: idx\tmx\tmy\tmz\tphi"
    ]

    idx = np.arange(m.shape[0])[:, np.newaxis]
    phi = np.zeros((m.shape[0], 1))
    tab = np.hstack((idx, m, phi))

    with open(filename, "w") as f:
        for line in header_lines:
            f.write(line + "\n")
        np.savetxt(f, tab, fmt=["%d", "%+.7e", "%+.7e", "%+.7e", "%.7e"], delimiter="\t")

    print(f"✅ File '{filename}' successfully written "
          f"({len(header_lines)} header lines and {m.shape[0]} data lines).")

def read_settings(settings_file):
    """
    Read the feeLLGood settings file: return the mesh file name, the length unit (m), and the
    exchange constant A (J/m) and anisotropy constant Ku (J/m^3) of the volume regions, which
    must all have the same values. The mesh file name is relative to the settings file.
    Numbers are converted with float(): PyYAML reads values like 1e-9 or -1.e5 as strings.
    """
    with open(settings_file, 'r') as f:
        settings = yaml.safe_load(f)
    mesh = settings['mesh']
    mesh_file = os.path.join(os.path.dirname(os.path.abspath(settings_file)), str(mesh['filename']))
    length_unit = float(mesh.get('length_unit', 1e-9))

    volume_regions = mesh.get('volume_regions') or {}
    if not volume_regions:
        sys.exit(f"❌ No volume region in '{settings_file}'")
    A = {float(prm['Ae']) for prm in volume_regions.values()}
    Ku = {float(prm['K']) for prm in volume_regions.values()}
    if len(A) != 1 or len(Ku) != 1:
        sys.exit(f"❌ The volume regions of '{settings_file}' must have the same Ae and K: "
                 "the curling profile is computed for a single material")
    for name, prm in volume_regions.items():
        uk = np.array([float(v) for v in prm.get('uk', [0, 0, 1])])
        if np.linalg.norm(np.cross(uk, [0, 0, 1])) > 1e-6 * np.linalg.norm(uk):
            warnings.warn(f"⚠️  uk of region '{name}' is not along z, the cylinder axis: "
                          "the curling profile assumes an anisotropy axis along the cylinder axis")
    return mesh_file, length_unit, A.pop(), Ku.pop(), set(volume_regions.keys())

def get_params():
    import argparse
    description = 'generate a config.sol file'
    epilogue = '''
fg-gensol-curling is an executable that generates the initial magnetization configuration (`.sol`
file) of the curling mode in a cylinder, for feeLLGood simulations. It reads the feeLLGood settings file: the mesh file name, its length unit,
and the material constants Ae and K of the volume regions. The radius of the cylinder is deduced
from the mesh. The input mesh file has to be readable by meshio python module.
It automatically detects physical volume regions in the input mesh and allows to define custom
vector fields for each region, in init_cfg.py.
'''

    parser = argparse.ArgumentParser(description=description, epilog=epilogue,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('settingsFileName',
            help='feeLLGood settings file (yaml), for example settings.yml')
    parser.add_argument('--version',action='version',version= __version__,
            help='show the version number')
    args = parser.parse_args()
    return args.settingsFileName

def main():
    """Main routine."""
    settings_file = get_params()
    mesh_file, length_unit, A, Ku, settings_regions = read_settings(settings_file)
    points, regions = load_mesh(mesh_file)

    # Region names must be the same in the mesh and in the settings file
    if set(regions.keys()) != settings_regions:
        sys.exit(f"❌ Volume regions differ between the mesh {sorted(regions.keys())} "
                 f"and '{settings_file}' {sorted(settings_regions)}")

    # Radius of the cylinder, deduced from the mesh (cylinder axis along z, through the origin)
    region_nodes = np.unique(np.concatenate([elem['nodes'] for elems in regions.values() for elem in elems]))
    R_mesh = np.max(np.hypot(points[region_nodes, 0], points[region_nodes, 1]))  # mesh units
    R = R_mesh * length_unit  # m
    kappa = (Ku * R**2) / (2 * A)
    print(f"mesh '{os.path.basename(mesh_file)}': R = {R_mesh:g} (x {length_unit:g} m), "
          f"A = {A:g} J/m, Ku = {Ku:g} J/m^3, kappa = {kappa:g}")
    # ---------------------------------------------------------------
    # Initialisation (Guess) et Resolution par solve_bvp
    # ---------------------------------------------------------------
    # Estimation initiale lineaire pour guider le solveur vers la solution non triviale
    rho = epsilon + (1.0 - epsilon) * np.linspace(0.0, 1.0, N)**2

    k = np.sqrt(2 * abs(kappa))
    omega_guess = (np.pi / 2) * np.tanh(k * rho)
    domega_guess = np.gradient(omega_guess, rho)
    y_guess = np.vstack([omega_guess, domega_guess])

    # Resolution
    sol = solve_bvp(make_ode(kappa), bc, rho, y_guess, tol=1e-7, max_nodes=1000000)
    print("[Euler-Lagrange / BVP] status :", sol.message)

    # Lorsque solve_bvp résout l'équation, il ne renvoie pas seulement une liste de points discrets.
    # Il calcule en arrière-plan une spline (un polynôme par morceaux) qui relie continûment tous les points du maillage.
    # Check if init_cfg.py exists in current directory
    init_cfg_path = os.path.abspath("init_cfg.py")
    if not os.path.isfile(init_cfg_path):
        print("⚠️  Module 'init_cfg.py' not found.")
        sys.exit(0)
    
    # Add current directory to Python path if necessary
    current_dir = os.getcwd()
    if current_dir not in sys.path:
        sys.path.insert(0, current_dir)
    
    # Import init_cfg (with reload if already cached)
    try:
        if 'init_cfg' in sys.modules:
            import importlib
            import init_cfg
            importlib.reload(init_cfg)
        else:
            import init_cfg
        
        region_functions = init_cfg.define_region_functions(sol.sol, R_mesh)
        
        if DEBUG:
            print(f"DEBUG: Regions in mesh: {sorted(regions.keys())}")
            print(f"DEBUG: Regions in init_cfg: {sorted(region_functions.keys())}")
        
        # Check that all regions have a function
        missing_regions = set(regions.keys()) - set(region_functions.keys())
        if missing_regions:
            print(f"⚠️  Missing regions in init_cfg.py: {missing_regions}")
            print("Regenerating init_cfg.py module...")
            sys.exit(0)

        # ---------------------------------------------------------------
        # Trace de omega(rho)
        # ---------------------------------------------------------------
        omega_bvp = sol.sol(rho)[0]
        plt.figure(figsize=(7, 5))
        plt.plot(rho, omega_bvp, '-', lw=2.5, color='tab:orange', label="Equation d'Euler-Lagrange (BVP)")
        plt.xlabel(r'$\rho = r/R$')
        plt.ylabel(r'$\omega(\rho)$ [rad]')
        plt.title("Profil adimensionne du mode curling dans un cylindre")
        plt.legend()
        plt.grid(alpha=0.3)
        plt.tight_layout()
        plt.savefig('curling_mode_adimensionne.png', dpi=150)
        plt.show()


        print("✅ All regions are defined, generating config.sol...")
        # If everything is OK, generate config.sol
        m = apply_region_functions(points, regions, region_functions)
        write_solution_file(m)
        
    except (AttributeError, Exception) as e:
        print(f"⚠️  Error importing 'init_cfg.py': {e}")
        import traceback
        traceback.print_exc()
        sys.exit(0)

__version__ = '1.1.0'
if __name__ == "__main__":
    main()
