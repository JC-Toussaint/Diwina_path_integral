def coherence(I, dx, dy, alpha):
    ''' I is the intensity, convolution in real space with gaussian function
    '''
    from scipy.signal import fftconvolve
    Ny, Nx = I.shape
    x = (np.arange(Nx) - (Nx - 1) / 2)*dx
    y = (np.arange(Ny) - (Ny - 1) / 2)*dy
    X, Y = np.meshgrid(x, y)

    if alpha==0:
        return I
    else:
        alpha_R = 1/(4*alpha)
        #print("alpha for divergence in image plane (m^-2)= ", alpha_R)
        G = np.exp(-alpha_R*(X**2 + Y**2)) #gaussian exp(-alpha*r^2)
        G /= G.sum()          # normalisation
        return fftconvolve(I, G, mode='same')

def aberration(E0_eV,defocus,Cs,k2) -> float:
    ''' aberration function : defocus + spherical aberration '''
    from numpy import pi
    lam = relativistic_wavelength(E0_eV)
    return pi*lam*k2*(defocus + 0.5*Cs*(lam**2)*k2)

def fresnel_enveloppe(phase, dx, dy, E0_eV, defocus, Cs, convergence):
    ''' convolution of an envelope and exp(j * chi) '''
    Ny, Nx = phase.shape

    psi0 = np.exp(1j * phase)
    kx = np.fft.fftshift(np.fft.fftfreq(Nx, d=dx))
    ky = np.fft.fftshift(np.fft.fftfreq(Ny, d=dy))
    KX, KY = np.meshgrid(kx, ky)
    k2 = KX**2 + KY**2
    envelope = np.exp(-(np.pi*convergence*defocus)**2 / np.log(2) * k2)
    chi = aberration(E0_eV,defocus,Cs,k2)
    H = np.exp(1j * chi) * envelope

    Psi0 = np.fft.fftshift(np.fft.fft2(np.fft.ifftshift(psi0)))
    Psi_def = Psi0 * H
    psi_def = np.fft.fftshift(np.fft.ifft2(np.fft.ifftshift(Psi_def)))
    return np.abs(psi_def)**2

def fresnel_mirrored(phase, dx, dy, crop, E0_eV, defocus, Cs):
    ''' compute fresnel contrast with mirror padding
    Mirror padding 2×2 — boundary conditions C⁰ on the image edges
    [ flip_xy | flip_y ]
    [ flip_x  |  φ     ]
    optionaly crop boolean might be turned True to center-crop by 2 the image
    '''
    from math import ceil

    Ny, Nx = phase.shape
    top_left  = np.flipud(np.fliplr(phase)) # horizontal and vertical flip
    top_right = np.flipud(phase)            # vertical flip
    bot_left  = np.fliplr(phase)            # horizontal flip
    bot_right = phase                       # original phase image
    
    phase_pad = np.block([ [top_left,  top_right], [bot_left,  bot_right]])
    # resulting shape: (2*Ny, 2*Nx)
    Ny_pad, Nx_pad = phase_pad.shape
    psi0 = np.exp(1j * phase_pad)
    
    # Grille de fréquences spatiales
    kx = np.fft.fftshift(np.fft.fftfreq(Nx_pad, d=dx)) #corrected
    ky = np.fft.fftshift(np.fft.fftfreq(Ny_pad, d=dy))
    KX, KY = np.meshgrid(kx, ky)
    k2 = KX**2 + KY**2

    chi = aberration(E0_eV,defocus,Cs,k2)
    H = np.exp(1j * chi)

    # Propagation dans l'espace de Fourier
    Psi0    = np.fft.fftshift(np.fft.fft2(np.fft.ifftshift(psi0)))
    Psi_def = Psi0 * H
    psi_def = np.fft.fftshift(np.fft.ifft2(np.fft.ifftshift(Psi_def)))
    
    # Extraire le quadrant original (bot_right → [Ny:2Ny, Nx:2Nx])
    psi_def_crop = psi_def[Ny:2*Ny, Nx:2*Nx]

    if crop: #possible de faire a part une fonction avec def d'un dictionnaire
        y1 = Ny + ceil(Ny/4)
        y2 = 2*Ny - ceil(Ny/4)
        x1 = Nx + ceil(Nx/4)
        x2 = 2*Nx - ceil(Nx/4)
        psi_def_crop = psi_def[y1:y2, x1:x2]
    return np.abs(psi_def_crop)**2 

