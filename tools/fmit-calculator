        def canvasClicked(self,pos):
            ''' plot a cross section along Ox direction at position y in nanometers of the Fresnel contrast image
            pos input is a mouse event, we only need ydata position to compute the corresponding y
            for the cross-section to compute. Then the cross section is computed onto self.I_used image
            '''
            Ny, Nx = self.I_used.shape
            y = pos.ydata
            if (y!=None) and self.canvasImage.cross_section_btn.isChecked():
                y0 = (int) (0.5*(Ny + 1e-9 * y/self.dy))
                s_y = str('{:.2e}'.format(y))
                self.ctrlPanel.updateLog("cross-section at y= " + s_y + " nm\n")
                fileBaseName = self.ctrlPanel.profileBaseName_input.text()
                profile = self.I_used[y0, :]
                x = (np.arange(Nx) - (Nx - 1) / 2) * int(self.dx*1e9)
                params = self.ctrlPanel.getParams()
                metadatas = "## defocus: " + str(params["defocus"]) + "\n"
                metadatas += "## convergence: " + str(params["convergence"]) + "\n"
                metadatas += "## E0: " + str(params["E0"]) + "\n"
                metadatas += "## Cs: " + str(params["Cs"]) + "\n"
                metadatas += "## V0: " + str(params["V0"]) + "\n"
                metadatas += "## crop: " + str(params["crop"]) + "\n"
                metadatas += "## mirrored: " + str(params["mirrored"]) + "\n"
                self.canvasCurve.updatePlot(x,profile,fileBaseName,s_y,metadatas)
                if fileBaseName != "":
                    fullFileName = fileBaseName + s_y + ".tsv"
                    self.ctrlPanel.updateLog("profile " + fullFileName + " written\n")
                self.canvasImage.updateImage(self.I_used,self.dx,self.dy,y)
                self.canvasImage.cross_section_btn.click()

        def computeContrast(self):
            '''
            slot that compute the Fresnel contrast image. It uses the holographic image contrast as
            an input, and add the electrostatic contribution. Then it applies defocussing and takes
            into account some aberration(s), and plot the corresponding image
            '''
            params = self.ctrlPanel.getParams()
            defocus = params["defocus"]
            convergence = params["convergence"]
            E0 = params["E0"]
            Cs = params["Cs"]
            V0 = params["V0"]
            C_e = electrical_constant(E0)
            self.ctrlPanel.logStr += f"   Ce(E0) = {C_e} (V*m)^-1\n"

            # Load phase + metadata
            phase,dx,dy,note = load_png(self.phaseFileName,True)
            self.ctrlPanel.updateLog(note + "\n")
            length,_,_,note = load_png(self.thicknessMapFileName,False)
            self.ctrlPanel.updateLog(note + "\n")

            phase = add_elec_phase(phase, length, C_e, V0)
            # Simulation Fresnel
            if params["mirrored"]:
                I = fresnel_mirrored(phase, dx, dy, params["crop"], E0, defocus, Cs)
            else:
                I= fresnel_enveloppe(phase, dx, dy, E0, defocus, Cs, convergence)

            alpha_F = (np.pi*defocus*convergence)**2/np.log(2)
            self.I_used = coherence(I, dx, dy, alpha_F)
            self.dx = dx
            self.dy = dy
            self.canvasImage.updateImage(self.I_used,self.dx,self.dy)
            params["phaseFileName"] = self.phaseFileName
            params["thicknessMapFileName"] = self.thicknessMapFileName
            imageBaseName = self.ctrlPanel.imageBaseName_input.text()
            if imageBaseName != "":
                save_png(imageBaseName + ".png",self.I_used,params)

    class YAMLSyntaxHighlighter(QSyntaxHighlighter):
        def __init__(self, parent=None):
            super().__init__(parent)
            self.key_format = QTextCharFormat()
            self.key_format.setForeground(QColor("black"))
            self.key_format.setFontWeight(QFont.Bold)
            self.value_format = QTextCharFormat()
            self.value_format.setForeground(QColor("red"))
            self.comment_format = QTextCharFormat()
            self.comment_format.setForeground(QColor("green"))
            # useless, regexp remove comments in highlightBlock function
        
        def highlightBlock(self, text):
            ''' homemade yaml highLighter '''
            comment_pattern = QRegExp(r'#.*')
            index = comment_pattern.indexIn(text)
            while index >= 0:
                length = comment_pattern.matchedLength()
                self.setFormat(index, length, self.comment_format)
                index = comment_pattern.indexIn(text, index + length)
        
            key_pattern = QRegExp(r'^(\s*)([^:\s]+)(\s*):')
            index = key_pattern.indexIn(text)
            while index >= 0:
                key_start = key_pattern.pos(2)
                key_length = len(key_pattern.cap(2))
                self.setFormat(key_start, key_length, self.key_format)
                index = key_pattern.indexIn(text, index + key_pattern.matchedLength())
        
            value_pattern = QRegExp(r':\s*(.+)$')
            index = value_pattern.indexIn(text)
            while index >= 0:
                value_start = value_pattern.pos(1)
                value_length = len(value_pattern.cap(1))
                if value_start >= 0:
                    self.setFormat(value_start, value_length, self.value_format)
                index = value_pattern.indexIn(text, index + value_pattern.matchedLength())

