        def update_mesh(self):
            ''' 3D replot of the mesh '''
            try:
                axes_angles = self.get_rotations_from_inputs()
                rotated_points = apply_sequential_quaternion_rotations(self.original_points, axes_angles)
                mesh = create_pyvista_mesh(rotated_points, self.triangles)
                self.plotter.clear_actors()
                self.plotter.add_mesh(mesh,smooth_shading=True,split_sharp_edges=True,color="lightblue")
                self.add_bounding_box_and_sensor(self.original_points, axes_angles)

            # Add magnetization vectors if available and enabled
                if (self.show_vectors_checkbox.isChecked() and 
                    self.magnetization_data is not None and 
                    self.surface_nodes is not None):
                    self.add_magnetization_vectors(axes_angles)
                
            # Grid and ticks X Y Z, grid and location are crucial
                self.plotter.show_bounds(
                    grid="back", location="outer",  ticks="both", all_edges=True,
                    xtitle="X", ytitle="Y", ztitle="Z", font_size=12)
                self.plotter.add_axes() # visible XYZ trihedral vectors

            except Exception as e:
                self.statusBar().showMessage(f"✗ Error while updating mesh: {e}")

        def add_magnetization_vectors(self, axes_angles):
            """ Add magnetization vectors to surface nodes using glyphs """
            try:
                positions = []
                vectors = []
                vector_scale = self.vector_scale_spinbox.value()
            
            # Collect all positions and vectors
                for node_idx in self.surface_nodes:
                    if node_idx in self.magnetization_data:
                        node_pos = self.original_points[node_idx]
                        m_vec = self.magnetization_data[node_idx]
                        positions.append(node_pos)
                        vectors.append(m_vec)
            
                if not positions:
                    self.statusBar().showMessage("✗ No magnetization data found for surface nodes!")
                    return

                positions = np.array(positions)
                vectors = np.array(vectors)
                rotated_positions = apply_sequential_quaternion_rotations(positions, axes_angles)
                rotated_vectors = apply_sequential_quaternion_rotations(vectors, axes_angles)
            
            # Create a PolyData object with rotated points and vectors
                vector_poly = pv.PolyData(rotated_positions)
                vector_poly['vectors'] = rotated_vectors * vector_scale
            
            # Create arrows using glyphs 
                vector_scale = self.vector_scale_spinbox.value()
                arrows = vector_poly.glyph(orient='vectors', scale=False, factor=vector_scale,
                    geom=pv.Arrow(tip_length=0.25, tip_radius=0.1, shaft_radius=0.05)
                )
            
                self.plotter.add_mesh(arrows, color='grey', opacity=0.8, show_scalar_bar=False)
                self.statusBar().showMessage(f"✓ Magnetization vectors plotted. If nothing is visible increase vector scale.")
                    
            except Exception as e:
                self.statusBar().showMessage(f"✗ Error adding magnetization vectors: {e}")
                import traceback
                traceback.print_exc()

        def add_bounding_box_and_sensor(self, original_points, axes_angles):
            """
            Add a bounding box around the mesh using 8 corners and 12 edges and a rectangle for
            the sensor
            """
            xmin, ymin, zmin = np.min(original_points, axis=0)
            xmax, ymax, zmax = np.max(original_points, axis=0)
        
            corners = np.array([
                [xmin, ymin, zmin],  # 0
                [xmax, ymin, zmin],  # 1
                [xmax, ymax, zmin],  # 2
                [xmin, ymax, zmin],  # 3
                [xmin, ymin, zmax],  # 4
                [xmax, ymin, zmax],  # 5
                [xmax, ymax, zmax],  # 6
                [xmin, ymax, zmax],  # 7
            ])
            
            rot_corners = apply_sequential_quaternion_rotations(corners, axes_angles)
            
            Xmin,Ymin,Zmin = np.min(rot_corners,axis=0)
            Xmax,Ymax,Zmax = np.max(rot_corners,axis=0)

            s = np.max([Xmax-Xmin,Ymax-Ymin])#sensor is a square of side s, center Xc,Yc in Zmin plane
            Xc = 0.5*(Xmin + Xmax)
            Yc = 0.5*(Ymin + Ymax)
            epsilon = 0.25*s #extra (Oz) translation to move away object from sensor
            g = self.sensor_size

            if not self.flagComputed:
                rectangle = pv.Rectangle([[(Xc-0.5*s)*g,(Yc-0.5*s)*g,Zmin-epsilon],
                                          [(Xc+0.5*s)*g,(Yc-0.5*s)*g,Zmin-epsilon],
                                          [(Xc+0.5*s)*g,(Yc+0.5*s)*g,Zmin-epsilon]])
                self.plotter.add_mesh(rectangle, show_edges=True, opacity=0.5, color="grey", line_width=4)
            else:
                self.add_sim_image((Xc-0.5*s)*g, (Yc-0.5*s)*g, Zmin-epsilon)

            self.add_wireframed_bbox(rot_corners)

        def add_wireframed_bbox(self,rot_corners):
            """ add to 3D a wireframed bounded box """
            self.add_wireframed_rect(rot_corners, [0, 1, 3, 2, 4, 5], 'red', 4)
            self.add_wireframed_rect(rot_corners, [1, 2, 0, 3, 4, 7], 'green', 4)
            self.add_wireframed_rect(rot_corners, [0, 4, 1, 5, 3, 7], 'blue', 4)
            self.add_wireframed_rect(rot_corners, [7, 6, 5, 6, 2, 6], 'black', 2)

        def add_wireframed_rect(self,rot_corners,edges,str_color,w):
            """ add to 3D a wired rectangle """
            line_points = np.array([rot_corners[edges[0]], rot_corners[edges[1]],
                                    rot_corners[edges[2]], rot_corners[edges[3]],
                                    rot_corners[edges[4]], rot_corners[edges[5]]])
            self.plotter.add_lines(line_points,color=str_color,width=w)

        def add_sim_image(self,corner_x,corner_y,corner_z):
            """ add a simulated image to 3D of dichroism or holography """
            if self.flagComputed:
                imageFileToRead = self.yaml_config['outputs']['file_basename']
                if self.whatSensor == "XMCD":
                    imageFileToRead += "_STXM_XMCD.png"
                else:
                    imageFileToRead += "_HOLO_PHASE.png"
                sim_image = pv.read(imageFileToRead)
                l_s= float(self.yaml_config['mesh']['length_unit']) # in some situations the cast is usefull
                px_s= float(self.yaml_config['sensor']['pixel_size'])
                ratio = px_s/l_s
                sim_image.scale([ratio,ratio,1.],inplace=True)
                sim_image.translate((corner_x,corner_y,corner_z),inplace=True)
                actor = self.plotter.add_mesh(sim_image,cmap='grey',show_scalar_bar=False)

        def compute(self):
            """Save YAML configuration and launch pathIntegral executable """
            self.save_yaml_config()
            isValid,message = check_solFile(self.yaml_config["initial_magnetization"])
            isMathExpr = "function" in self.yaml_config["initial_magnetization"] #this is not enough
            if (self.outputFileName != "noneYet") and (isValid or isMathExpr):
                self.compute_btn.setEnabled(False)
                self.statusBar().showMessage(f"✓ YAML file saved: {self.outputFileName}, launch ray-tracing computations ...")
                self.lastLog = open("lastLog.log","wb")
                self.lastErr = open("lastErr.log","wb")
                self.process = QProcess()
                self.process.readyReadStandardOutput.connect(self.handle_pathIntegral_stdout)
                self.process.readyReadStandardError.connect(self.handle_pathIntegral_stderr)
                self.process.errorOccurred.connect(self.process_failed_to_start)
                self.process.finished.connect(self.process_finished)
                if os.name == "nt":
                    self.process.start("wsl.exe",["pathIntegral",self.outputFileName])
                elif os.name == "posix":
                    self.process.start("pathIntegral",[self.outputFileName])
            else:
                self.statusBar().showMessage("Error: .sol not yet selected, or " + message)
                self.compute_btn.setEnabled(True)

        def process_failed_to_start(self):
            ''' tell the user we could not start the program '''
            self.statusBar().showMessage("Error: failed to start pathIntegral.")

        def process_finished(self):
            ''' when pathIntegral (launched in a Qprocess) ends we end up here '''
            self.statusBar().showMessage("✓ Computations done, .out and .png files saved, lastLog.log (over)written.")
            self.process = None
            self.lastLog.close()
            self.lastErr.close()
            self.flagComputed = True
            self.compute_btn.setEnabled(True)
            for i in [1,2,3]:
                self.right_visualizations.setTabEnabled(i,True)
            self.update_mesh()

        def handle_pathIntegral_stdout(self):
            ''' write pathIntegral stdout's in a log file '''
            out = self.process.readAllStandardOutput()
            self.lastLog.write(out)

        def handle_pathIntegral_stderr(self):
            ''' write pathIntegral stderr's in an err log file '''
            err = self.process.readAllStandardError()
            if err:
                self.statusBar().showMessage("Error while ray tracing.")
                self.lastErr.write(err)

        def quit_and_save(self):
            """Save YAML configuration before quitting"""
            try:
                self.save_yaml_config()
            except Exception as e:
                reply = QMessageBox.question(
                    self, 
                    'Error Saving', 
                    f"Error saving configuration: {e}\n\nDo you still want to quit?",
                    QMessageBox.Yes | QMessageBox.No,
                    QMessageBox.No
                )
                if reply == QMessageBox.No:
                    return
            self.close()
except:
    print("Error: PyQt5 module(s) not imported")
    sys.exit()

def get_params():
    ''' parse command line '''
    import argparse
    description = 'fmit-calculator: pathIntegral GUI frontend'
    epilogue = '''
    lauch a graphic user interface as a front-end to pathIntegral command line executable
    save a yaml file from the inputs within the graphic user interface
    launch pathIntegral executable from GUI to compute .out and .png outputs
    3D renderer and raw view of the output png's in a basic viewer
    '''
    parser = argparse.ArgumentParser(description=description, epilog=epilogue, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('ymlFileName',nargs='?',
        help= """Optional yaml settings input file. If not provided fmit-calculator starts with some default parameters,
        and the user may open a yaml file from file menu""", 
        default=None)
    parser.add_argument('--version',action='version',version= __version__,help='show the version number')
    args = parser.parse_args()
    return args

def launchGUI(ymlFileName):
    try:
        from PyQt5.QtWidgets import QApplication
        QApplication.setStyle("cleanlooks")
        app = QApplication(sys.argv)
        window = CombinedInterface(ymlFileName)
        window.show()
        sys.exit(app.exec_())
    finally:
        sys.exit()

def main():
    '''
    launch the parsing of the command line
    detect if on windows or unix-like platform
    On windows, try to launch the GUI, on unix-like, try to fix some environnment variables for
    nvidia GPU if any. Then it tries to launch the GUI if PyQt5 is available else exit
    '''
    args = get_params()
    if (os.name == "nt"):
        launchGUI(args.ymlFileName)
    elif (os.name == "posix"):
        display = os.environ.get('DISPLAY') #might not run correctly on WayLand, see WAYLAND_DISPLAY environment variable
        if ((display == "") or (display is None)):
            print("Error: no display.")
            sys.exit()
        else:
            if has_nvidia_gpu():
                os.environ["__NV_PRIME_RENDER_OFFLOAD"] = "1"
                os.environ["__GLX_VENDOR_LIBRARY_NAME"] = "nvidia"
            else:
                print("Warning: no NVIDIA GPU detected.")
            launchGUI(args.ymlFileName)

__version__ = '1.3.1'
if __name__ == "__main__":
    main()
